# ==============================================================================
# AmazonWatch - Arquivo de Configuração de Exemplo (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
# cp .env.example .env
# ==============================================================================

# Configurações do Banco de Dados PostgreSQL / PostGIS
POSTGRES_USER=amazonwatch_user
POSTGRES_PASSWORD=exemplo_senha_super_secreta_123!
POSTGRES_DB=amazonwatch_db
DB_PORT=5434

# Portas de Acesso aos Serviços (Host)
API_PORT=8000
FRONTEND_PORT=3000

# Backend FastAPI (Conexão local para desenvolvimento sem Docker)
DATABASE_URL=postgresql+psycopg://amazonwatch_user:exemplo_senha_super_secreta_123!@localhost:5434/amazonwatch_db
MEDIA_DIR=/data/media

# Ingestão e Processamento Geoespacial
PIPELINE_INTERVAL_MINUTES=5
HOTSPOTS_BACKFILL_HOURS=24
ADP_BACKFILL_HOURS=6
FRAMES_BACKFILL_HOURS=3
SMOKE_MIN_CONFIDENCE=low
SMOKE_MIN_PIXELS=10

# CORS (Lista JSON de origens autorizadas)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Chave de API Externa (Exemplo Fictício)
VITE_CARTO_API_KEY=carto_pk_exemplo_ficticio_99a8b7c6d5e4f321

# Segurança e Autenticação JWT
JWT_SECRET=exemplo_jwt_secret_key_ficticio_gerar_uma_chave_segura_de_pelo_menos_32_caracteres_xyz987
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
