# Configurações do Banco de Dados
POSTGRES_USER=amazonwatch
POSTGRES_PASSWORD=amazonwatch
POSTGRES_DB=amazonwatch
DB_PORT=5433

# Portas dos Serviços
API_PORT=8000
FRONTEND_PORT=3000

# Backend FastAPI (local dev)
DATABASE_URL=postgresql+psycopg://amazonwatch:amazonwatch@localhost:5433/amazonwatch
MEDIA_DIR=/data/media

# Ingestão e Processamento
PIPELINE_INTERVAL_MINUTES=5
HOTSPOTS_BACKFILL_HOURS=24
ADP_BACKFILL_HOURS=6
FRAMES_BACKFILL_HOURS=3
SMOKE_MIN_CONFIDENCE=low
SMOKE_MIN_PIXELS=10

# CORS (lista JSON) — necessário apenas para o dev server do Vite
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# CARTO API Key (opcional)
VITE_CARTO_API_KEY=
